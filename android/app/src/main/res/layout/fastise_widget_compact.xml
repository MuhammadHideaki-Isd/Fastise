<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_obsidian"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top row: Streak pill -->
    <LinearLayout
        android:id="@+id/widget_streak_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="9dp"
        android:paddingBottom="3dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="Streak"
            android:src="@drawable/ic_streak_flame" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Start Day 1"
            android:textColor="#F2F5F3"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Center: Expressive Fasty mascot -->
    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Fasty mascot"
        android:src="@drawable/ic_mascot_idle" />

    <!-- Live Chronometer when fasting, or headline -->
    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#82D4B2"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Ready to fast?"
        android:textColor="#F2F5F3"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="16:8"
        android:textColor="#9AA69F"
        android:textSize="10.5sp" />
</LinearLayout>
